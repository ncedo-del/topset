{
  "name": "topset",
  "private": true,
  "description": "TOPSET - athlete performance platform (static PWA + Firebase). This package.json only carries dev tooling; the app itself has no build step.",
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-topset \"node --test tests/rules/\"",
    "test": "npm run check && npm run test:rules",
    "emulators": "firebase emulators:start --only firestore --project demo-topset",
    "migrate:invite-codes": "node scripts/migrate-invite-codes.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.12.2",
    "firebase-admin": "^12.3.0",
    "firebase-tools": "^13.15.0"
  },
  "engines": { "node": ">=20" }
}
